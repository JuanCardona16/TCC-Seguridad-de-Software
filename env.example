# Copiar a .env si querés sobreescribir los valores por defecto del laboratorio:
#   cp env.example .env
POSTGRES_PASSWORD=lab

# Clave maestra de 32 bytes (64 caracteres hex) para el cifrado AES-256-GCM de
# documentos en reposo del modo endurecido. Es una clave DE LABORATORIO: en un
# sistema real viviría en un KMS o en variables inyectadas por el gestor de
# secretos, jamás en un archivo versionado.
DOCS_MASTER_KEY=8f2b6d1c4a9e7f305b8c2d6a1e9f4b7c3d5a8e2f6b1c9d4a7e3f5b8c2d6a1e9f

# Secreto de firma HMAC de las cookies de sesión (modo endurecido).
SESSION_SECRET=cambiar-por-un-valor-aleatorio-largo-de-laboratorio

# Usuarios demo creados por la app al primer arranque:
#   admin / admin123   (administrador, con 2FA disponible)
#   alice / alice123   (usuaria, dueña de documentos confidenciales)
#   bob   / bob123     (usuario)
